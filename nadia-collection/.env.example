# Sanity CMS Configuration
# Copy this file to .env.local (never commit .env.local).
# Local development and builds work with built-in fallback data when unset.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret used to verify POST /api/revalidate webhooks from Sanity (send via signature or header)
SANITY_REVALIDATE_SECRET=

# Optional canonical production site URL for metadata, robots.txt, and sitemap.xml
# Example: https://nadia-collection.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional Sanity Editor/Write token used ONLY for one-time seeding via scripts/seed-sanity.mjs
# Never expose this token as a NEXT_PUBLIC_* variable
SANITY_API_WRITE_TOKEN=
